// use prisma-next

model User {
  id          String       @id
  created_at  DateTime     @default(now())
  updated_at  temporal.updatedAt()
  devices     Device[]
  connections Connection[]

  @@map("ayrock.busy.user")
}

model Device {
  id           String    @id
  created_at   DateTime  @default(now())
  updated_at   temporal.updatedAt()
  name         String?
  access_token String?
  expires_at   DateTime?
  user         User      @relation(fields: [user_id], references: [id])
  user_id      String

  @@map("ayrock.busy.device")
}

model Connection {
  id            String    @id
  created_at    DateTime  @default(now())
  updated_at    temporal.updatedAt()
  type          String
  access_token  String?
  refresh_token String?
  expires_at    DateTime?
  event_id      String?
  next_event_at DateTime?
  user          User      @relation(fields: [user_id], references: [id])
  user_id       String

  @@unique([user_id, type])
  @@map("ayrock.busy.connection")
}
